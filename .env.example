# --- OpenAI ---
# Required only when TRIAGE_LLM_MODE is 'assist' or 'shadow'.
OPENAI_API_KEY=sk-proj-your-key-here

# Model used for the narrow document-text judgments (see src/llm/).
TRIAGE_MODEL=gpt-5-mini

# How the LLM participates in a run:
#   off    - fully deterministic; no network calls (default, and what `make determinism` should use)
#   assist - LLM adjudicates only documents the deterministic classifier flags as ambiguous
#   shadow - LLM runs alongside and disagreements are logged, but the deterministic result wins
TRIAGE_LLM_MODE=off

# Cache LLM judgments on disk keyed by content hash, so repeat runs stay deterministic.
TRIAGE_LLM_CACHE_DIR=.cache/llm

# --- Logging ---
NODE_ENV=development
LOG_LEVEL=info
